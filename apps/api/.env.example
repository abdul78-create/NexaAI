# ==============================================================================
# NexaAI Backend Configuration (.env.example)
# Copy this file to .env for local development: cp .env.example .env
# ==============================================================================

# Application Metadata
APP_NAME="NexaAI API"
APP_ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1

# Security & Authentication (Placeholder for Phase 5)
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev_secret_key_change_in_production_min_32_chars_long

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Database (PostgreSQL + asyncpg)
# Compatible with infra/docker-compose.yml
DATABASE_URL=postgresql+asyncpg://nexaai_user:changeme_in_env@localhost:5432/nexaai

# Redis (Caching & Rate Limiting placeholder)
REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO

# AI Integration (Google Gemini Primary / OpenAI Optional Fallback)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.5-flash
ENABLE_MOCK_AI_FALLBACK=true

# Optional OpenAI Integration (e.g. for Whisper Speech-to-Text)
# OPENAI_API_KEY=sk-... (Leave empty to default to Mock STT provider)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Chat Modes Configuration (Gemini Model Routing)
CHAT_MODE_LOW_MODEL=gemini-2.5-flash
CHAT_MODE_STANDARD_MODEL=gemini-2.5-flash
CHAT_MODE_HIGH_MODEL=gemini-2.5-pro
CHAT_MODE_HIGH_DAILY_LIMIT=5

# Vision & Multimodal Configuration
VISION_PROVIDER=gemini
VISION_MODEL=gemini-2.5-flash

# Embeddings & RAG Configuration
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=gemini-embedding-001

# Speech-to-Text (Independent subsystem: OpenAI Whisper or Mock)
STT_PROVIDER=mock
STT_MODEL=whisper-1

# OAuth Providers (Leave empty to disable provider buttons in UI)
AUTH_FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

