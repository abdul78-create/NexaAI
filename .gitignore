# ============================================================
# NexaAI — .gitignore
# ============================================================

# Environment secrets — NEVER commit
.env
.env.local
.env.*.local

# Node / Next.js
node_modules/
.next/
out/
dist/
.turbo/
*.tsbuildinfo
.vercel

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
.venv/
venv/
env/
ENV/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# Alembic
apps/api/alembic/versions/*.pyc

# Uploads / generated files
uploads/
temp/
*.tmp

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Docker volumes (if mounted locally)
infra/pgdata/
infra/redisdata/

# Logs
logs/
*.log
npm-debug.log*

# Build artifacts
apps/web/.next/
apps/web/out/
